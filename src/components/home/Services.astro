---
import Icon from '../Icon.astro';
import { services } from '../../config/site';
---

<section id="services" class="section section-soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2>Everything your store needs, under one roof.</h2>
      <p>Pick one service or hand us the whole thing — we plug in wherever you need help.</p>
    </div>

    <ul class="grid">
      {
        services.map((s) => (
          <li class="card">
            <span class="icon">
              <Icon name={s.icon} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 20px;
  }

  .icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  p {
    color: var(--text-muted);
  }
</style>
