---
import Icon from '../Icon.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { site, stats, whatsappLink } from '../../config/site';
---

<section class="hero">
  <div class="container inner">
    <span class="eyebrow">E-commerce studio</span>
    <h1>{site.tagline}</h1>
    <p class="lede">{site.description}</p>

    <div class="actions">
      <a href={whatsappLink()} class="btn btn-whatsapp" target="_blank" rel="noopener">
        <WhatsAppIcon />
        Chat on WhatsApp
      </a>
      <a href="#services" class="btn btn-ghost">
        See our services
        <Icon name="arrow" />
      </a>
    </div>

    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 12vw, 140px) clamp(56px, 8vw, 96px);
  }

  /* Soft accent glow behind the headline */
  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto;
    height: 120%;
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
    z-index: -1;
  }

  .inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: 800;
    max-width: 14ch;
  }

  .lede {
    margin-top: 20px;
    max-width: 580px;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(24px, 6vw, 64px);
    margin: clamp(48px, 8vw, 72px) 0 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stats dt {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
  }
</style>
