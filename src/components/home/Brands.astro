---
import Icon from '../Icon.astro';
import { brands, featuredReview } from '../../config/site';
---

<section id="brands" class="section section-soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Brands we've worked with</span>
      <h2>Trusted by growing brands.</h2>
    </div>

    <ul class="logos">
      {
        brands.map((b) => (
          <li>{b.logo ? <img src={b.logo} alt={b.name} loading="lazy" /> : <span>{b.name}</span>}</li>
        ))
      }
    </ul>

    <figure class="review">
      <Icon name="quote" class="quote-icon" />
      <blockquote>{featuredReview.quote}</blockquote>
      <figcaption>
        <strong>{featuredReview.name}</strong>
        <span>{featuredReview.role}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logos li {
    display: grid;
    place-items: center;
    height: 88px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .logos img {
    max-height: 40px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.8;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease;
  }

  .logos li:hover img {
    filter: none;
    opacity: 1;
  }

  .review {
    margin: clamp(40px, 6vw, 64px) auto 0;
    max-width: 760px;
    text-align: center;
  }

  .review :global(.quote-icon) {
    width: 40px;
    height: 40px;
    margin: 0 auto 16px;
    color: var(--accent);
  }

  blockquote {
    margin: 0;
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  figcaption {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  figcaption span {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
