---
import { site, nav, emailLink, whatsappLink } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid">
    <div>
      <a href="/" class="logo">{site.name}</a>
      <p class="muted">{site.tagline}</p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul>
        <li><a href={emailLink()}>{site.contact.email}</a></li>
        <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container bottom muted">© {year} {site.name}. All rights reserved.</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-top: 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
  }

  .logo {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .muted {
    color: var(--text-muted);
  }

  .grid p {
    margin-top: 8px;
  }

  h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--text-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  ul a:hover {
    color: var(--text);
  }

  .bottom {
    margin-top: 48px;
    padding-block: 24px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .grid > :first-child {
      grid-column: 1 / -1;
    }
  }
</style>
